# Copiez ce fichier vers .env.docker puis remplacez toutes les valeurs change-me.
MYSQL_DATABASE=cms_builder
MYSQL_USER=cms_builder
MYSQL_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-root-password
DATABASE_URL=mysql://cms_builder:change-me-database-password@db:3306/cms_builder

APP_ORIGIN=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false

# Utilisées uniquement avec le profil tools pour créer/réinitialiser un admin.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrateur
ADMIN_PASSWORD=change-me-admin-password
